# Clé secrète Django (obligatoire en production)
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=qrcodebykriss.fr,www.qrcodebykriss.fr,127.0.0.1,localhost
